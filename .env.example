# ── Database ──────────────────────────────────────────────────────────────────
# Use the SESSION POOLER string from Supabase → Settings → Database → Connection string
# (NOT the direct host — the direct host is IPv6-only, unreachable from Render/Railway)
DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres

# ── Supabase ──────────────────────────────────────────────────────────────────
SUPABASE_URL=https://[ref].supabase.co
# Service role key — backend only. NEVER expose to frontend.
SUPABASE_SERVICE_KEY=your-service-role-key-here

# ── AI Model ──────────────────────────────────────────────────────────────────
# Will be filled in Week 5 when Person 3's model is integrated
MODEL_PATH=./models/chest_xray_seg.pth

# ── App ───────────────────────────────────────────────────────────────────────
ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
